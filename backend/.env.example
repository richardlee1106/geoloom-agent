LLM_MODEL=astron-code-latest
LLM_TIMEOUT_MS=12000
LLM_ANALYSIS_TIMEOUT_MS=60000
LLM_MAX_TOKENS=2048
LLM_SYNTHESIS_TIMEOUT_MS=45000
NARRATIVE_LLM_NARRATION_TIMEOUT_MS=
LLM_FALLBACK_PROTOCOL=anthropic
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_ANTHROPIC_VERSION=2023-06-01
LLM_FALLBACK_MAX_TOKENS=1024
SPATIAL_ENCODER_BASE_URL=
SPATIAL_ENCODER_ENCODE_PATH=/encode-text
SPATIAL_ENCODER_HEALTH_PATH=/health
SPATIAL_ENCODER_TIMEOUT_MS=3000
SPATIAL_VECTOR_BASE_URL=
SPATIAL_VECTOR_POI_PATH=/search/semantic-pois
SPATIAL_VECTOR_REGION_PATH=/search/similar-regions
SPATIAL_VECTOR_HEALTH_PATH=/health
