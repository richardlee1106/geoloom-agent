VITE_GEOLOOM_API_BASE=http://127.0.0.1:3210

# Multi Search Engine 配置
MULTI_SEARCH_TIMEOUT_MS=10000
MULTI_SEARCH_MAX_ENGINES=3

# Tavily 搜索配置（可选，支持主 key + 备用 key 无感切换）
TAVILY_API_KEY=
TAVILY_API_KEY1=
TAVILY_API_KEY2=
TAVILY_API_KEY3=
TAVILY_TIMEOUT_MS=15000

# Jina 在线 API 配置（Embedding + Reranker）
JINA_API_KEY=jina_80e6454ac38e4a00bf0acffb8af217553ItatcfIpcemcYdaFEYhSOXjMzMW
JINA_EMBED_URL=https://api.jina.ai/v1
JINA_RERANK_URL=https://api.jina.ai/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_RERANKER_MODEL=jina-reranker-v3

# DeepSeek Search API（NewAPI / DeepSeek 原生 search 模型）
DEEPSEEK_SEARCH_BASE_URL=https://api.deepsb.com
DEEPSEEK_SEARCH_API_KEY=
DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash-search-nothinking
DEEPSEEK_SEARCH_TIMEOUT_MS=6000

# Narrative LLM Narrator（GraphRAG 解说，仅负责自然语言表达）
LLM_BASE_URL=https://api.deepsb.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash-search-nothinking
NARRATIVE_LLM_NARRATION_ENABLED=true
NARRATIVE_LLM_NARRATION_TIMEOUT_MS=18000