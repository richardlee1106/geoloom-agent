VITE_BACKEND_VERSION=v4
VITE_DEV_API_BASE=http://127.0.0.1:3210
VITE_AI_DEV_API_BASE=http://127.0.0.1:3210
VITE_SPATIAL_DEV_API_BASE=http://127.0.0.1:3210

# Embedding API (OpenAI-compatible)
EMBED_API_KEY=
EMBED_BASE_URL=https://www.hohy6.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Reranker (optional, fallback to local Jaccard if unavailable)
RERANK_URL=https://api.jina.ai/v1
RERANKER_MODEL=jina-reranker-v3

# DeepSeek Search API via NewAPI native search model
DEEPSEEK_SEARCH_BASE_URL=https://api.deepsb.com/v1
DEEPSEEK_SEARCH_API_KEY=
DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash-search-nothinking
DEEPSEEK_SEARCH_TIMEOUT_MS=60000

# Narrative LLM Narrator GraphRAG generation
LLM_BASE_URL=https://api.deepsb.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash-search-nothinking
NARRATIVE_LLM_BASE_URL=https://api.deepsb.com/v1
NARRATIVE_LLM_API_KEY=
NARRATIVE_LLM_MODEL=deepseek-v4-flash-search-nothinking
NARRATIVE_LLM_NARRATION_ENABLED=true
NARRATIVE_LLM_NARRATION_TIMEOUT_MS=45000

# OmniVoice TTS (HTTP API mode, requires: pip install omnivoice-server)
OMNIVOICE_HTTP_URL=http://127.0.0.1:8880
OMNIVOICE_VOICE=fable
OMNIVOICE_TIMEOUT_MS=120000
NARRATIVE_TTS_ENABLED=true